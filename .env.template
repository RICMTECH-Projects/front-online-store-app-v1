# URL del backend REST. Debe terminar en /api/v1 una sola vez.
# Solo se lee desde el servidor de Next.js; nunca usar NEXT_PUBLIC_ aquí.
API_BASE_URL=http://localhost:8080/api/v1

# ID de un almacén real con stock provisionado en este entorno.
# El valor 1 corresponde únicamente al escenario de desarrollo de ejemplo.
CHECKOUT_WAREHOUSE_ID=1

# NODE_ENV lo establece Next.js automáticamente; no hace falta configurarlo.
